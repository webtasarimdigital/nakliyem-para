rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── GÜVENLİK YARDIMCI FONKSİYONLARI ────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCarrier() {
      return isAuthenticated() && getUserData().role == 'CARRIER';
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN';
    }

    // ── 1. KULLANICI PROFİLLERİ (HASSAS VERİ) ─────────────────
    // Kimse başkasının profilini, e-postasını veya telefonunu okuyamaz
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── 2. NAKLİYECİ FİRMA PROFİLLERİ ───────────────────────────
    // Firma profili herkese açık okunabilir; sadece firma sahibi veya admin düzenleyebilir
    match /carriers/{carrierId} {
      allow read: if true;
      allow create: if isCarrier();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── 3. TAŞINMA TALEPLERİ (MÜŞTERİ TALEPLERİ) ───────────────
    // Talepler listelenebilir; talep sahibi müşteri veya admin güncelleyebilir/silebilir
    match /requests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin() || isCarrier());
      allow delete: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    // ── 4. TEKLİFLER ──────────────────────────────────────────
    // Sadece onaylı nakliyeciler teklif verebilir; teklif sahibi nakliyeci veya talep sahibi müşteri görebilir
    match /offers/{offerId} {
      allow read: if isAuthenticated();
      allow create: if isCarrier();
      allow update: if isAuthenticated() && (resource.data.carrierId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.carrierId == request.auth.uid || isAdmin());
    }

    // ── 5. NAKLİYECİ DEFTERİ (CANLI İLAN AKIŞI) ───────────────
    // İlanlar herkese açık okunur; sadece ilanı açan nakliyeci silebilir
    match /defter_posts/{postId} {
      allow read: if true;
      allow create: if isCarrier();
      allow update, delete: if isAuthenticated() && (resource.data.carrierId == request.auth.uid || isAdmin());
    }

    // ── 6. MÜŞTERİ YORUM & PUANLARI (MANİPÜLASYON KORUMALI) ───
    // Yorumlar herkese açık okunur; sonradan değiştirilemez veya silinemez
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.customerId;
      allow update, delete: if isAdmin(); // Kullanıcı veya firma yorumu sonradan değiştiremez
    }

    // ── 7. MESAJLAŞMA & SOHBET ODALARI ────────────────────────
    // Sadece sohbete taraf olan 2 kullanıcı mesajları okuyabilir ve yazabilir
    match /conversations/{convId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || 
        request.auth.uid in request.resource.data.participants || 
        isAdmin()
      );

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
